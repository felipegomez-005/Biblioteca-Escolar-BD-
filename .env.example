# Copiar como .env y completar localmente. No compartir ni subir las claves.
# Habilitar Books API en el proyecto de Google Cloud de esta clave.
GOOGLE_BOOKS_API_KEY=

# --- Avisos por correo (SMTP) ---
# Servidor y remitente de los recordatorios de devolución.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
